APP_ENV=local
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=true
NEXT_PUBLIC_FIREBASE_API_KEY=demo-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-barum.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-barum
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=demo-barum.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
NEXT_PUBLIC_FIREBASE_APP_ID=demo-app
FIREBASE_STAGING_PROJECT_ID=
FIREBASE_PRODUCTION_PROJECT_ID=
# Optional until a server feature actually needs Admin SDK credentials.
# Base64-encoded JSON. Never add NEXT_PUBLIC_ to this variable.
FIREBASE_SERVICE_ACCOUNT_JSON=
