# Runtime: local | preview | production. Vercel uses VERCEL_ENV automatically.
APP_ENV=local
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=false
# Firebase Web config: public identifiers from Firebase Console > Project settings > Your apps.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=barum-10aad.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=barum-10aad
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=barum-10aad.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=1088662752621
NEXT_PUBLIC_FIREBASE_APP_ID=1:1088662752621:web:d6ba066c449dab9cf29e64
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-EFCNLHH2BJ
FIREBASE_PROJECT_ID=barum-10aad
# Firebase Admin service-account JSON encoded as one Base64 line. Server-only.
# PowerShell: [Convert]::ToBase64String([IO.File]::ReadAllBytes('service-account.json'))
FIREBASE_SERVICE_ACCOUNT_JSON=
# Public Data Portal general authentication key (Decoding value), server-only.
# KMA: Short-term Forecast API. Empty => Open-Meteo weather fallback.
KMA_SERVICE_KEY=
# KHOA: Tide Prediction API. Empty => reference sea-level model fallback.
KHOA_SERVICE_KEY=
