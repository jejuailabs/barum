{
  "name": "barum",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0 <23"
  },
  "scripts": {
    "predev": "node scripts/prepare-fonts.mjs",
    "prebuild": "node scripts/prepare-fonts.mjs",
    "dev": "next dev --hostname localhost",
    "build": "next build",
    "start": "next start --hostname localhost",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && node scripts/check-boundaries.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test --grep-invert @a11y",
    "a11y": "playwright test --grep @a11y",
    "i18n:check": "node scripts/check-i18n.mjs",
    "analyze": "node scripts/check-bundle.mjs",
    "emulators": "node scripts/emulators.mjs start",
    "test:rules": "node scripts/emulators.mjs test"
  },
  "dependencies": {
    "firebase": "^12.0.0",
    "firebase-admin": "^14.4.0",
    "next": "15.5.25",
    "next-intl": "^4.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "server-only": "^0.0.1",
    "zod": "^4.0.0"
  },
  "overrides": {"next": {"postcss": "^8.5.23"}, "gaxios": {"uuid": "^11.1.1"}},
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@eslint/eslintrc": "^3.0.0",
    "@firebase/rules-unit-testing": "^5.0.0",
    "@fontsource-variable/noto-sans-jp": "^5.3.0",
    "@fontsource-variable/noto-sans-sc": "^5.3.0",
    "@fontsource-variable/noto-sans-tc": "^5.3.0",
    "@formatjs/icu-messageformat-parser": "^3.5.20",
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "15.5.25",
    "firebase-tools": "^15.0.0",
    "postcss": "^8.5.0",
    "pretendard": "^1.3.9",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
